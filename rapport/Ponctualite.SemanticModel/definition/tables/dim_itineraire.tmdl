/// Itinéraires porte à porte : le nom configuré, clé des faits, et un libellé public sans arrêt ni horaire
table dim_itineraire

	column itineraire
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: itineraire

	/// Libellé générique (clé « nom_public » de la configuration) : c'est lui qu'affiche le rapport en mode public
	column libelle_public
		dataType: string
		summarizeBy: none
		sourceColumn: libelle_public
		sortByColumn: ordre

	column ordre
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ordre

	partition dim_itineraire = entity
		mode: directLake
		source
			entityName: dim_itineraire
			schemaName: gold
			expressionSource: DatabaseQuery

