  "queries": [
    {
      "id": "3bf37650-ef7d-5fb9-9b3a-9d8dc1c3dcfc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "let dernier = toscalar(departs | summarize max(releve));\nlet instantane = departs | where releve > dernier - 2m;\nprint ['Dernier relevé'] = format_datetime(datetime_utc_to_local(dernier, 'Europe/Zurich'), 'HH:mm:ss')",
      "usedVariables": []
    },
    {
      "id": "6c0860ed-690a-5225-8f3f-d2c73ba6021d",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "let dernier = toscalar(departs | summarize max(releve));\nlet instantane = departs | where releve > dernier - 2m;\ninstantane | where depart_prevu >= now() - 2m | summarize ['Départs annoncés'] = count()",
      "usedVariables": []
    },
    {
      "id": "0664e6c5-27bc-5750-b9ee-42847878fb96",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "let dernier = toscalar(departs | summarize max(releve));\nlet instantane = departs | where releve > dernier - 2m;\ninstantane | where depart_prevu >= now() - 2m | summarize ['Retard moyen annoncé (min)'] = round(avg(retard_min), 1)",
      "usedVariables": []
    },
    {
      "id": "a58add64-9f16-543a-9c6e-d473d8c021ae",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "let dernier = toscalar(departs | summarize max(releve));\nlet instantane = departs | where releve > dernier - 2m;\ninstantane | where depart_prevu >= now() - 2m | summarize ['Annulés ou non desservis'] = countif(annule or non_desservi)",
      "usedVariables": []
    },
    {
      "id": "298a08a7-880f-500f-98db-b23deb34b173",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "let dernier = toscalar(departs | summarize max(releve));\nlet instantane = departs | where releve > dernier - 2m;\ninstantane\n| where depart_prevu >= now() - 2m\n| project ['Arrêt'] = arret, ['Prévu'] = format_datetime(datetime_utc_to_local(depart_prevu, 'Europe/Zurich'), 'HH:mm'), ['Estimé'] = format_datetime(datetime_utc_to_local(coalesce(depart_estime, depart_prevu), 'Europe/Zurich'), 'HH:mm'),\n    ['Retard (min)'] = retard_min, Ligne = strcat(mode, ' ', ligne), Destination = destination,\n    Quai = coalesce(quai_estime, quai_prevu), ['Perturbé'] = annule or non_desservi, tri = depart_prevu\n| order by ['Arrêt'] asc, tri asc\n| project-away tri",
      "usedVariables": []
    },
    {
      "id": "cd3a449a-c630-531a-a66c-e797aadab121",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "let dernier = toscalar(departs | summarize max(releve));\nlet instantane = departs | where releve > dernier - 2m;\ninstantane\n| where depart_prevu >= now() - 2m and isnotnull(retard_min)\n| summarize ['Retard moyen (min)'] = round(avg(retard_min), 1) by Ligne = strcat(mode, ' ', ligne)\n| order by ['Retard moyen (min)'] desc",
      "usedVariables": []
    },
    {
      "id": "ce05c784-cfa5-55bb-b657-69a7f049555d",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "departs\n| where releve between (_startTime .. _endTime)\n| where ligne in ('IR90', 'RE33', 'IC1', 'R1', 'R2', '28', '360', '362', 'm1') and isnotnull(retard_min)\n| summarize ['Retard moyen (min)'] = round(avg(retard_min), 1) by bin(releve, 5m), Ligne = ligne\n| order by releve asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "e907eac9-98fa-5d41-8049-0c4bc13c537f",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "departs\n| where releve between (_startTime .. _endTime)\n| where annule or non_desservi\n| summarize arg_max(releve, *) by course_ref, arret\n| project ['Vu à'] = format_datetime(datetime_utc_to_local(releve, 'Europe/Zurich'), 'HH:mm'), ['Arrêt'] = arret,\n    ['Prévu'] = format_datetime(datetime_utc_to_local(depart_prevu, 'Europe/Zurich'), 'HH:mm'), Ligne = strcat(mode, ' ', ligne), Destination = destination,\n    Motif = iff(annule, 'Course annulée', 'Arrêt non desservi')\n| order by ['Vu à'] desc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "37f7b1af-e14b-5e1b-9154-7d3c26b72550",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "departs\n| where releve between (_startTime .. _endTime) and isnotnull(retard_min)\n| where ligne in ('IR90', 'RE33', 'IC1', 'R1', 'R2', '28', '360', '362', 'm1')\n| extend ['Minutes avant le départ'] = 5 * bin(datetime_diff('minute', depart_prevu, releve), 5)\n| where ['Minutes avant le départ'] between (0 .. 60)\n| summarize ['Retard moyen annoncé (min)'] = round(avg(retard_min), 2),\n    ['Part des départs à 3 min ou plus (%)'] = round(100.0 * countif(retard_min >= 3) / count(), 1)\n    by ['Minutes avant le départ']\n| order by ['Minutes avant le départ'] desc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "984e170c-da1b-5e52-866a-eb461ab024ce",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "aafba942-b9ad-5ab0-a304-f6ce8734edce"
      },
      "text": "departs\n| where releve between (_startTime .. _endTime) and isnotnull(retard_min)\n| where ligne in ('IR90', 'RE33', 'IC1', 'R1', 'R2', '28', '360', '362', 'm1')\n| extend ['Minutes avant le départ'] = datetime_diff('minute', depart_prevu, releve)\n| where ['Minutes avant le départ'] between (0 .. 60)\n| summarize retard_final = arg_min(['Minutes avant le départ'], retard_min), retard_premier = arg_max(['Minutes avant le départ'], retard_min), releves = count() by course_ref, arret\n| where releves >= 3\n| summarize ['Courses suivies'] = count(), ['Retard connu dès la 1re annonce (%)'] = round(100.0 * countif(abs(retard_final - retard_premier) < 1) / count(), 1)",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    }
  ],
